        <mxCell id="demarc_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=1.5;fontSize=10.5;align=left;spacingLeft=8;fontColor=#7f0000;" value="&lt;b style=&quot;color:#b71c1c;font-size:12px;&quot;&gt;WAN DEMARCATION POINTS (CE &amp;lt;-&amp;gt; PE)&lt;/b&gt;&lt;br&gt;• Boundary between TVI Enterprise Edge &amp;amp; ISP AS 65000&lt;br&gt;• PAT / NAT Overload translates Private /16 to Public /30&lt;br&gt;• eBGP Peering + Route Summarization at Gi0/0&lt;br&gt;• Outbound LLQ QoS Policy (VoIP EF 30% / Video AF31 20%)" vertex="1">
          <mxGeometry height="110" width="290" x="865" y="580" as="geometry" />
        </mxCell>
        <mxCell id="vpn_overlay_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6a1b9a;strokeWidth=2;dashed=1;fontSize=11;align=left;spacingLeft=10;fontColor=#38006b;" value="&lt;b style=&quot;font-size:13px;color:#4a148c;&quot;&gt;GRE OVER IPSEC VPN OVERLAY (STEP 6 &amp;amp; STEP 8)&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;b&gt;1. Tunnel12 (HQ &amp;lt;-&amp;gt; Hanoi R&amp;amp;D):&lt;/b&gt;&lt;br&gt;• IPv4: &lt;b&gt;172.16.12.0/30&lt;/b&gt; (.1 HQ &amp;lt;-&amp;gt; .2 HN)&lt;br&gt;• IPv6: &lt;b&gt;2001:DB8:CAFE:12::/64&lt;/b&gt; (::1 &amp;lt;-&amp;gt; ::2)&lt;br&gt;&lt;b&gt;2. Tunnel13 (HQ &amp;lt;-&amp;gt; Da Nang Hub):&lt;/b&gt;&lt;br&gt;• IPv4: &lt;b&gt;172.16.13.0/30&lt;/b&gt; (.1 HQ &amp;lt;-&amp;gt; .2 DN)&lt;br&gt;• IPv6: &lt;b&gt;2001:DB8:CAFE:13::/64&lt;/b&gt; (::1 &amp;lt;-&amp;gt; ::2)&lt;br&gt;&lt;hr&gt;• &lt;b&gt;Routing:&lt;/b&gt; OSPFv2 &amp;amp; OSPFv3 Area 0 over GRE/IPsec&lt;br&gt;• &lt;b&gt;Crypto:&lt;/b&gt; IKE AES-256 / SHA-256 / DH Grp 14 | MTU 1400, MSS 1360&lt;br&gt;• &lt;b&gt;QoS:&lt;/b&gt; LLQ Priority Queueing for VoIP (DSCP EF) &amp;amp; Video (AF31)" vertex="1">
          <mxGeometry height="265" width="320" x="850" y="744.73" as="geometry" />
        </mxCell>
        <mxCell id="hn_container" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f8e9;strokeColor=#2e7d32;strokeWidth=2;verticalAlign=top;align=center;spacingTop=8;fontColor=#1b5e20;arcSize=3;" value="&lt;b style=&quot;font-size:15px;&quot;&gt;HANOI R&amp;amp;D &amp;amp; AI ENGINEERING CAMPUS — BGP AS 65002&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;&quot;&gt;Supernet Summary: 10.20.0.0/16, 192.168.2.0/24 &amp;amp; 2001:DB8:20::/48 | Router-on-a-Stick (802.1Q) + LACP + Extended ACL Guest Isolation&lt;/font&gt;" vertex="1">
