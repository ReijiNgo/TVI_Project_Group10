        <mxCell id="isp_dns_lo0" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#37474f;strokeWidth=2;fontSize=11;fontColor=#263238;" value="&lt;b style=&quot;font-size:12px;&quot;&gt;Simulated Public Internet / DNS&lt;/b&gt;&lt;br&gt;Interface: &lt;b&gt;Loopback0&lt;/b&gt;&lt;br&gt;IPv4: &lt;b&gt;8.8.8.8/32&lt;/b&gt;&lt;br&gt;IPv6: &lt;b&gt;2001:4860:4860::8888/128&lt;/b&gt;&lt;br&gt;(Advertised via eBGP to AS 65001/2/3)" vertex="1">
