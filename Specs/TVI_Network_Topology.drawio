        <!-- ==================== TITLE BANNER ==================== -->
        <mxCell id="title_banner" value="&lt;b style=&quot;font-size:20px;&quot;&gt;TECHVIET INNOVATIONS (TVI) — ENTERPRISE NETWORK LOGICAL &amp;amp; PHYSICAL TOPOLOGY (STEP 1)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;&quot;&gt;Hierarchical Dual-Stack (IPv4 VLSM / IPv6 GUA) | Multi-AS eBGP WAN | GRE over IPsec VPN Overlay | OSPFv2/v3 Underlay | HSRP + LACP + Rapid-PVST+ | Netmiko IaC Automation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0d2b4e;strokeColor=#081b33;fontColor=#ffffff;align=center;verticalAlign=middle;arcSize=6;" vertex="1" parent="1">
