        <!-- Hanoi Management & Security Note -->
        <mxCell id="hn_mgmt_note" value="&lt;b&gt;Hanoi Management &amp;amp; L2 Hardening (VLAN 99: 192.168.2.0/24 | 2001:DB8:20:99::/64):&lt;/b&gt;&lt;br&gt;• Netmiko SSHv2 Provisioning Target: &lt;b&gt;HANOI-RND-SW01 (192.168.2.10)&lt;/b&gt;, SW02 (192.168.2.11)&lt;br&gt;• LACP EtherChannel &lt;b&gt;Port-channel 1 (Gi0/2–Gi0/3)&lt;/b&gt; active between SW01 &amp;amp; SW02&lt;br&gt;• DHCP Snooping + Dynamic ARP Inspection (DAI) enabled on VLAN 20, 50 | Unused Ports -&amp;gt; VLAN 999 (shutdown)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e7d32;fontSize=10.5;align=left;spacingLeft=10;fontColor=#1b5e20;" vertex="1" parent="1">
