        <!-- VPN Overlay & QoS Box (Center-Bottom) -->
        <mxCell id="vpn_overlay_box" value="&lt;b style=&quot;font-size:13px;color:#4a148c;&quot;&gt;GRE OVER IPSEC VPN OVERLAY (STEP 6 &amp;amp; STEP 8)&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;b&gt;1. Tunnel12 (HQ &amp;lt;-&amp;gt; Hanoi R&amp;amp;D):&lt;/b&gt;&lt;br&gt;• IPv4: &lt;b&gt;172.16.12.0/30&lt;/b&gt; (.1 HQ &amp;lt;-&amp;gt; .2 HN)&lt;br&gt;• IPv6: &lt;b&gt;2001:DB8:CAFE:12::/64&lt;/b&gt; (::1 &amp;lt;-&amp;gt; ::2)&lt;br&gt;&lt;b&gt;2. Tunnel13 (HQ &amp;lt;-&amp;gt; Da Nang Hub):&lt;/b&gt;&lt;br&gt;• IPv4: &lt;b&gt;172.16.13.0/30&lt;/b&gt; (.1 HQ &amp;lt;-&amp;gt; .2 DN)&lt;br&gt;• IPv6: &lt;b&gt;2001:DB8:CAFE:13::/64&lt;/b&gt; (::1 &amp;lt;-&amp;gt; ::2)&lt;br&gt;&lt;hr&gt;• &lt;b&gt;Routing:&lt;/b&gt; OSPFv2 &amp;amp; OSPFv3 Area 0 over GRE/IPsec&lt;br&gt;• &lt;b&gt;Crypto:&lt;/b&gt; IKE AES-256 / SHA-256 / DH Grp 14 | MTU 1400, MSS 1360&lt;br&gt;• &lt;b&gt;QoS:&lt;/b&gt; LLQ Priority Queueing for VoIP (DSCP EF) &amp;amp; Video (AF31)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6a1b9a;strokeWidth=2;dashed=1;fontSize=11;align=left;spacingLeft=10;fontColor=#38006b;" vertex="1" parent="1">
          <mxGeometry x="850" y="835" width="320" height="310" as="geometry" />
        </mxCell>

